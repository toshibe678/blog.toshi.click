---
/**
 * 日付をフォーマットして表示するコンポーネント
 * YYYY-MM-DD形式で日付を出力します
 */
interface Props {
	date: Date; // 表示する日付オブジェクト
}

const { date } = Astro.props;
---

<time datetime={date.toISOString()}>
{
  (() => {
    // 日付を YYYY-MM-DD 形式に変換
    const year = date.getFullYear(); // 年を取得
    const month = String(date.getMonth() + 1).padStart(2, '0'); // 月を取得し2桁になるよう0埋め (JavaScriptの月は0始まり)
    const day = String(date.getDate()).padStart(2, '0'); // 日を取得し2桁になるよう0埋め
    return `${year}-${month}-${day}`; // YYYY-MM-DD形式の文字列を返す
  })()
}
</time>
